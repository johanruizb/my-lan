{
  "name": "mylan-workspace",
  "private": true,
  "version": "0.6.1",
  "type": "module",
  "scripts": {
    "dev": "npm run --prefix apps/desktop-tauri tauri -- dev",
    "build": "npm run --prefix apps/desktop-tauri tauri -- build",
    "build:cli": "cargo build --release -p mylan-cli",
    "clean": "rm -rf target apps/desktop-tauri/src-tauri/target apps/desktop-tauri/src-tauri/gen apps/desktop-tauri/dist",
    "clean:cache": "rm -rf ~/.npm ~/.cargo/registry ~/.cargo/git",
    "clean:all": "npm run clean && rm -rf apps/desktop-tauri/node_modules && npm run clean:cache"
  }
}
